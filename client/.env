# ========================================
# API CONFIGURATION
# ========================================

# Backend server URL
# This tells our React app where to send API requests
# 
# In development: http://localhost:5000/api
# In production: https://yourdomain.com/api
# 
# Vite requires env variables to start with VITE_ to be accessible
VITE_API_URL=http://localhost:5000/api