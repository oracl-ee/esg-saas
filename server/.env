# ========================================
# SERVER CONFIGURATION
# ========================================

# Port number the server will run on
# Default: 5000 (make sure it doesn't conflict with other apps)
PORT=5000

# Environment mode - tells the app if we're developing or in production
# Values: "development" or "production"
NODE_ENV=development

# ========================================
# DATABASE CONNECTION
# ========================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# 
# Breakdown:
# - postgres = default PostgreSQL username
# - postgres = default PostgreSQL password (change this later!)
# - localhost = database is on this computer
# - 5432 = PostgreSQL default port
# - california_esg_dev = name of our database (we'll create this later)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/california_esg_dev

# ========================================
# SECURITY
# ========================================

# Secret key for encrypting JWT tokens (user login sessions)
# IMPORTANT: In production, use a long random string!
# You can generate one at: https://randomkeygen.com/
# This is just a placeholder for development
JWT_SECRET=your-super-secret-key-change-this-later-12345